<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Symptom_Checker.SymtomChecker">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:id="@+id/Symptoms_Input"
        android:visibility="visible">


        <!-- Basic Information -->
    <TextView
        android:id="@+id/tvBasicInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Basic Information"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Age"
        android:inputType="number"
        android:maxLines="2"
        android:maxLength="3"/>

    <RadioGroup
        android:id="@+id/rgGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male" />
        <RadioButton
            android:id="@+id/rbFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female" />
        <RadioButton
            android:id="@+id/rbOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other" />
    </RadioGroup>

        <TextView
            android:id="@+id/ttMedicalHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical History" />
        <RadioGroup
            android:id="@+id/rgMedicalHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbMedicalHistoryYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbMedicalHistoryNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

    <EditText
        android:id="@+id/etMedicalHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:hint="Medical History"
        android:visibility="invisible"/>

    <!-- Common Symptoms -->
    <TextView
        android:id="@+id/tvCommonSymptoms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Common Symptoms"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvFever"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fever" />
    <RadioGroup
        android:id="@+id/rgFever"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbFeverYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbFeverNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvCough"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cough" />
    <RadioGroup
        android:id="@+id/rgCough"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbCoughDry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dry" />
        <RadioButton
            android:id="@+id/rbCoughProductive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Productive" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvPain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pain" />
    <RadioGroup
        android:id="@+id/rgPain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbPainMild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mild" />
        <RadioButton
            android:id="@+id/rbPainModerate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moderate" />
        <RadioButton
            android:id="@+id/rbPainSevere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Severe" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvFatigue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fatigue" />
    <RadioGroup
        android:id="@+id/rgFatigue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbFatigueYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbFatigueNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvShortnessOfBreath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shortness of Breath" />
    <RadioGroup
        android:id="@+id/rgShortnessOfBreath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbShortnessOfBreathYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbShortnessOfBreathNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvHeadache"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Headache" />
    <RadioGroup
        android:id="@+id/rgHeadache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbHeadacheYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbHeadacheNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvNauseaVomiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nausea/Vomiting" />
    <RadioGroup
        android:id="@+id/rgNauseaVomiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbNauseaVomitingYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbNauseaVomitingNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvDiarrheaConstipation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diarrhea/Constipation" />
    <RadioGroup
        android:id="@+id/rgDiarrheaConstipation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbDiarrheaConstipationYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />
        <RadioButton
            android:id="@+id/rbDiarrheaConstipationNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>
        <TextView
            android:id="@+id/Rash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rash" />
        <RadioGroup
            android:id="@+id/rgRash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbRashYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbRashNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>
        <TextView
            android:id="@+id/Dizziness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dizziness" />
        <RadioGroup
            android:id="@+id/rgDizziness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbDizzinessYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbDizzinessNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

<!--        Specific Symptoms-->
        <TextView
            android:id="@+id/tvSpecificSymtoms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specific Symptoms"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/Chest_Pain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chest Pain" />
        <RadioGroup
            android:id="@+id/rgChest_Pain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbChestPainYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbChestPainNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/AbdominalPain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abdominal Pain" />
        <RadioGroup
            android:id="@+id/rgAbdominalPain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbAbdominalPainYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbAbdominalPainNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/Joint_Pain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joint Pain" />
        <RadioGroup
            android:id="@+id/rgJoint_Pain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbJoint_PainYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbJoint_PainNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/Urinary_Systoms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Urinary Systoms" />
        <RadioGroup
            android:id="@+id/rgUrinary_Systoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbUrinary_SystomsYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbUrinary_SystomsNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/Skin_Change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skin Change" />
        <RadioGroup
            android:id="@+id/rgSkin_Change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbSkin_ChangeYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbSkin_ChangeNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/Vision_Pain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vision Pain" />
        <RadioGroup
            android:id="@+id/rgVision_Pain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbVision_PainYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbVision_PainNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <TextView
            android:id="@+id/Hearing_Changes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hearing Changes" />
        <RadioGroup
            android:id="@+id/rgHearing_Changes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbHearing_ChangesYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />
            <RadioButton
                android:id="@+id/rbHearing_ChangesNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
        </RadioGroup>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:id="@+id/sumbmit_btn"
            android:layout_gravity="center"/>

    </LinearLayout>



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            app:cardCornerRadius="15dp"
            android:visibility="invisible"
            android:id="@+id/SymptomsResult_output"

            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!--                android:layout_margin="120dp">-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="I Recommend seeing a pediatrician as soon as possible"
                    android:textColor="#FF0000"
                    android:textStyle="bold"
                    android:textSize="20dp"
                    android:paddingTop="30dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:text="response"
                    android:textColor="@color/black"
                    android:id="@+id/tvSymptomsResult"/>

                <Button
                    android:id="@+id/SymptomsResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:text="GO Back to Home Page" />



            </LinearLayout>


        </androidx.cardview.widget.CardView>
        </RelativeLayout>
    </ScrollView>

</FrameLayout>
</layout>